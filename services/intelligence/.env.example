# Apenas no servidor. Não usar prefixo VITE_ nestas credenciais.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
NEWSLETTER_MODEL=gpt-6.1-sol
# Modelo de imagens separado do modelo de texto. Só usado quando o administrador escolhe IA.
NEWSLETTER_IMAGE_MODEL=gpt-image-2
AUTH_URL=https://sua-api-de-autenticacao
HASURA_URL=https://seu-hasura/v1/graphql
CORS_ORIGINS=https://seu-frontend
DATABASE_URL=postgresql://usuario:senha@host-do-postgres:5432/banco-do-hasura
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
# Compatibilidade opcional autorizada: apenas no servidor e somente para admin validado em /auth/me.
HASURA_ADMIN_SECRET=
